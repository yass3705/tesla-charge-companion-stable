      "feePeriod": "one_time",
      "defaultSelected": false,
      "quotaBased": false,
      "rankableWhenSelected": true,
      "notes": "IZIVIA Access has no recurring subscription; the 15 EUR Pass acquisition cost is never allocated to an individual charging session."
    }
  ],
  "offers": [
    {
      "id": "qpark-izivia-pass-standard",
      "channel": "subscription",
      "subscriptionId": "qpark-izivia-pass-access",
      "provider": "Q-Park / Pass IZIVIA",
      "selectors": {
        "physicalOperatorIds": ["izivia"]
      },
      "pricingRules": [
        {
          "scope": "allDay",
          "start": "00:00",
          "end": "24:00",
          "currency": "EUR",
          "pricePerKwh": 0.55,
          "chargePerMinute": 0,
          "connectionFee": 1.20,
          "durationPerMinute": 0,
          "occupancyPerMinute": 0,
          "parkingPerMinute": 0
        }
      ],
      "rankable": true,
      "note": "Q-Park publishes a 1.20 EUR/session + 0.55 EUR/kWh tariff explicitly reserved to Pass IZIVIA holders."
    },
    {
      "id": "qpark-ad-hoc-reference",
      "channel": "reference",
      "provider": "Q-Park Paynow / other payment methods",
      "selectors": {
        "physicalOperatorIds": ["izivia"]
      },
      "pricingRules": [],
      "rankable": false,
      "blockedReasons": ["ad_hoc_tariff_not_published_by_qpark"],
      "note": "Q-Park lists Paynow QR and other mobility cards as accepted methods, but its published tariff is explicitly marked as reserved to Pass IZIVIA holders."
    }
  ],
  "notes": [
    "The Q-Park-branded IRVE station currently resolved to Electra must not inherit this Q-Park/IZIVIA tariff.",
    "Car-park parking fees remain separate from charging costs."
  ]
