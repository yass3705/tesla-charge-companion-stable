{
  "schemaVersion": 1,
  "engine": "tcc-v9-unified-data",
  "rules": {
    "loadRelevantSourcesInParallel": true,
    "mergeBeforePrune": true,
    "operatorsDerivedFromFinalStations": true,
    "sourceMayRemoveForeignEntities": false,
    "routingBudgetAppliedAfterFilters": true
  },
  "sources": [
    {
      "id": "tesla-global",
      "label": "Tesla Superchargers global",
      "adapter": "tesla-json",
      "path": "data/tesla_stations.json",
      "countries": ["*"],
      "capabilities": ["inventory", "connectors", "access", "tariff"],
      "priority": {"identity": 100, "connectors": 100, "access": 95, "status": 80, "tariff": 100},
      "refresh": "on-demand-or-published-snapshot",
      "active": true
    },
    {
      "id": "france-national",
      "label": "France national non-Tesla catalogue",
      "adapter": "national-compact-v1",
      "root": "data/non_tesla_france/",
      "manifest": "data/non_tesla_france/manifest.json",
      "countries": ["FR"],
      "capabilities": ["inventory", "connectors", "access", "status", "tariff_fallback"],
      "priority": {"identity": 55, "connectors": 60, "access": 55, "status": 45, "tariff": 30},
      "refresh": "monthly-or-on-demand",
      "active": true
    },
    {
      "id": "netherlands-dotnl",
      "label": "DOT-NL national catalogue",
      "adapter": "national-compact-v3",
      "root": "data/non_tesla_netherlands/",
      "manifest": "data/non_tesla_netherlands/manifest.json",
      "countries": ["NL"],
      "capabilities": ["inventory", "connectors", "access", "status", "tariff_fallback"],
      "priority": {"identity": 60, "connectors": 65, "access": 70, "status": 65, "tariff": 35},
      "refresh": "monthly-static-plus-dynamic-overlay",
      "active": true
    },
    {
      "id": "netherlands-direct-offers",
      "label": "Netherlands verified direct offers",
      "adapter": "direct-offer-json",
      "path": "data/netherlands_direct_tariffs_v1.json",
      "countries": ["NL"],
      "capabilities": ["tariff", "subscription"],
      "priority": {"tariff": 95},
      "refresh": "on-demand",
      "active": true
    },
    {
      "id": "ionity-direct-france",
      "label": "IONITY France direct inventory/offers",
      "adapter": "direct-station-gzip",
      "path": "data/ionity_direct_stations_france.json.gz",
      "countries": ["FR"],
      "operatorIds": ["ionity"],
      "capabilities": ["inventory", "connectors", "tariff"],
      "priority": {"identity": 90, "connectors": 90, "tariff": 95},
      "refresh": "on-demand",
      "active": true
    },
    {
      "id": "atlante-direct-france",
      "label": "Atlante France direct inventory/offers",
      "adapter": "direct-station-gzip",
      "path": "data/atlante_direct_stations_france.json.gz",
      "countries": ["FR"],
      "operatorIds": ["atlante"],
      "capabilities": ["inventory", "connectors", "tariff"],
      "priority": {"identity": 90, "connectors": 90, "tariff": 95},
      "refresh": "on-demand",
      "active": true
    },
    {
      "id": "powerdot-direct-france",
      "label": "Powerdot France direct inventory/offers",
      "adapter": "direct-station-gzip",
      "path": "data/powerdot_direct_france.json.gz",
      "countries": ["FR"],
      "operatorIds": ["powerdot"],
      "capabilities": ["inventory", "connectors", "tariff"],
      "priority": {"identity": 90, "connectors": 90, "tariff": 95},
      "refresh": "on-demand",
      "active": true
    },
    {
      "id": "belib-direct-france",
      "label": "Belib France verified station tariffs",
      "adapter": "direct-tariff-gzip",
      "path": "data/belib_station_tariffs_v1.json.gz",
      "countries": ["FR"],
      "operatorIds": ["belib"],
      "capabilities": ["tariff", "subscription"],
      "priority": {"tariff": 95},
      "refresh": "on-demand",
      "active": true
    },
    {
      "id": "e55c-direct-france",
      "label": "E55C France verified station tariffs",
      "adapter": "direct-tariff-gzip",
      "path": "data/e55c_station_tariffs_v1.json.gz",
      "countries": ["FR"],
      "operatorIds": ["e55c"],
      "capabilities": ["tariff"],
      "priority": {"tariff": 95},
      "refresh": "on-demand",
      "active": true
    },
    {
      "id": "etotem-direct-france",
      "label": "e-Totem France verified tariffs",
      "adapter": "direct-tariff-gzip",
      "path": "data/etotem_direct_tariffs_france.json.gz",
      "countries": ["FR"],
      "operatorIds": ["etotem"],
      "capabilities": ["tariff"],
      "priority": {"tariff": 95},
      "refresh": "on-demand",
      "active": true
    },
    {
      "id": "user-stations",
      "label": "User-added stations",
      "adapter": "runtime-user-stations",
      "countries": ["*"],
      "capabilities": ["inventory", "connectors", "access", "tariff"],
      "priority": {"identity": 110, "connectors": 110, "access": 110, "status": 40, "tariff": 110},
      "refresh": "runtime",
      "active": true
    }
  ]
}
