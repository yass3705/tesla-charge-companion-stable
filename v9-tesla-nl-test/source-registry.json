{
  "schemaVersion": 1,
  "engine": "tcc-v9-unified-data",
  "rules": {
    "loadRelevantSourcesInParallel": true,
    "mergeBeforePrune": true,
    "operatorsDerivedFromFinalStations": true,
    "sourceMayRemoveForeignEntities": false,
    "routingBudgetAppliedAfterFilters": true,
    "exactCrosswalkBeforeFuzzyMatching": true,
    "dynamicStatusMustBeFresh": true
  },
  "subscriptionCoverage": [
    {
      "subscriptionId": "fastned-gold",
      "countries": [
        "FR",
        "NL"
      ],
      "operatorIds": [
        "fastned"
      ],
      "evidenceSources": [
        "france-canonical-direct-offers",
        "netherlands-direct-offers"
      ]
    }
  ],
  "sources": [
    {
      "id": "tesla-global",
      "label": "Tesla \u2014 SuC Tracker web candidate + legacy-only stations",
      "adapter": "tesla-json",
      "path": "../v9-tesla-nl-test/tesla_stations.json",
      "countries": [
        "*"
      ],
      "capabilities": [
        "inventory",
        "connectors",
        "access",
        "tariff"
      ],
      "priority": {
        "identity": 100,
        "connectors": 100,
        "access": 95,
        "status": 80,
        "tariff": 100
      },
      "refresh": "weekly-web-snapshot",
      "active": true,
      "supplementPath": "data/tesla_stations.json",
      "metadataPath": "../v9-tesla-nl-test/metadata.json"
    },
    {
      "id": "netherlands-dotnl",
      "label": "DOT-NL national catalogue",
      "adapter": "national-compact-v3",
      "root": "data/non_tesla_netherlands/",
      "manifest": "data/non_tesla_netherlands/manifest.json",
      "countries": [
        "NL"
      ],
      "capabilities": [
        "inventory",
        "connectors",
        "access",
        "status",
        "tariff_fallback"
      ],
      "priority": {
        "identity": 60,
        "connectors": 65,
        "access": 70,
        "status": 65,
        "tariff": 35
      },
      "refresh": "monthly-static-plus-dynamic-overlay",
      "active": true
    },
    {
      "id": "netherlands-direct-offers",
      "label": "Netherlands verified direct offers",
      "adapter": "direct-offer-json",
      "path": "data/netherlands_direct_tariffs_v1.json",
      "countries": [
        "NL"
      ],
      "capabilities": [
        "tariff",
        "subscription"
      ],
      "priority": {
        "tariff": 95
      },
      "refresh": "on-demand",
      "active": true,
      "optional": true
    }
  ]
}
